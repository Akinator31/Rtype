# Writes a C++ header holding the GLSL source of the stages of a shader program, as strings. Run at build time
# by rtype_embed_shader() with:
#   PROGRAM  name of the program, for instance "Lighting"
#   SOURCES  its GLSL files, separated by "|": .vert for the vertex stage, .frag for the fragment stage
#   OUTPUT   header to write
# Lighting.vert becomes rtype::shaders::lightingVertex, Lighting.frag becomes lightingFragment.

string(SUBSTRING "${PROGRAM}" 0 1 first)
string(SUBSTRING "${PROGRAM}" 1 -1 rest)
string(TOLOWER "${first}" first)
set(variable "${first}${rest}")

set(header "#pragma once\n\n// Generated by EmbedShader.cmake from libs/shaders/glsl: edit the GLSL files, not this header.\n")
string(APPEND header "\nnamespace rtype::shaders\n{\n")

string(REPLACE "|" ";" sources "${SOURCES}")
foreach(source IN LISTS sources)
    get_filename_component(extension "${source}" LAST_EXT)
    if(extension STREQUAL ".vert")
        set(stage "Vertex")
    elseif(extension STREQUAL ".frag")
        set(stage "Fragment")
    else()
        message(FATAL_ERROR "Unknown shader stage for ${source}: use .vert or .frag")
    endif()
    file(READ "${source}" glsl)
    string(APPEND header "\ninline constexpr const char *${variable}${stage} = R\"glsl(${glsl})glsl\";\n")
endforeach()

string(APPEND header "\n} // namespace rtype::shaders\n")
file(WRITE "${OUTPUT}" "${header}")
