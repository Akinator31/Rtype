#pragma once

// Generated by CMake from keys/development/server.pub: change the key there.

#include "rtype/network/Tls.hpp"

#include <string_view>

namespace rtype::keys
{

/// This build trusts the development key: a Debug build (ADR 0020). A Release build refuses it.
#ifdef RTYPE_DEVELOPMENT_KEY
inline constexpr bool DevelopmentKeyTrusted = true;
#else
inline constexpr bool DevelopmentKeyTrusted = false;
#endif

/// The public key of the development key pair, committed in keys/development/. Its private key is public too:
/// it only protects local games and tests.
inline constexpr std::string_view DevelopmentPublicKey = R"pem(@RTYPE_DEVELOPMENT_PUBLIC_KEY@)pem";

/// The fingerprint of the development key.
[[nodiscard]] inline const network::KeyFingerprint &developmentFingerprint()
{
    static const network::KeyFingerprint fingerprint = network::KeyFingerprint::ofPublicKey(DevelopmentPublicKey);
    return fingerprint;
}

} // namespace rtype::keys
