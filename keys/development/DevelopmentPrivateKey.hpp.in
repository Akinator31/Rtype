#pragma once

// Generated by CMake from keys/development/server.key: change the key there.

#ifndef RTYPE_DEVELOPMENT_KEY
#error "The development private key is only built into Debug builds (ADR 0020)"
#endif

#include <string_view>

namespace rtype::keys
{

/// The private key of the development key pair, which a Debug server uses when it has no key of its own.
/// Public, since it is committed: never in a release.
inline constexpr std::string_view DevelopmentPrivateKey = R"pem(@RTYPE_DEVELOPMENT_PRIVATE_KEY@)pem";

} // namespace rtype::keys
